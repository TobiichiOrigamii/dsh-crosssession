{
  "name": "dsh-crosssession",
  "version": "0.1.0",
  "description": "Cross-session messaging, persistent session team, approval gates and a per-session task board for DeepSeek Harness (DSH).",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "index.js",
    "client.js",
    "board.html",
    "cordis.patch.yml",
    "policy.example.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "multi-agent",
    "agent-team",
    "task-board",
    "session"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TobiichiOrigamii/dsh-crosssession.git"
  },
  "homepage": "https://github.com/TobiichiOrigamii/dsh-crosssession#readme",
  "bugs": {
    "url": "https://github.com/TobiichiOrigamii/dsh-crosssession/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
